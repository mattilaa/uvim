if(NOT DEFINED UVIM_CONFIG OR NOT DEFINED TEST_DIRECTORY)
    message(FATAL_ERROR "UVIM_CONFIG and TEST_DIRECTORY are required")
endif()

function(generate name)
    execute_process(COMMAND "${UVIM_CONFIG}" --preset embedded
        --build-dir "${TEST_DIRECTORY}/${name}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${name}: ${output}\n${error}")
    endif()
endfunction()

generate(gcc --compiler GCC --c-compiler /toolchain/gcc
    --cxx-compiler /toolchain/g++)
generate(clang --compiler Clang)
generate(msvc --compiler MSVC)
generate(auto --compiler Auto)
foreach(pair IN ITEMS "gcc|/toolchain/gcc|/toolchain/g++"
        "clang|clang|clang++" "msvc|cl|cl")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 name)
    list(GET fields 1 cc)
    list(GET fields 2 cxx)
    file(READ "${TEST_DIRECTORY}/${name}/uvim_config_cache.cmake" cache)
    foreach(language IN ITEMS C CXX)
        if(language STREQUAL C)
            set(expected "${cc}")
        else()
            set(expected "${cxx}")
        endif()
        string(FIND "${cache}" "set(CMAKE_${language}_COMPILER \"${expected}\"" found)
        if(found EQUAL -1)
            message(FATAL_ERROR "${name}: incorrect ${language} compiler")
        endif()
    endforeach()
endforeach()
file(READ "${TEST_DIRECTORY}/auto/uvim_config_cache.cmake" cache)
if(cache MATCHES "CMAKE_C(X{2})?_COMPILER")
    message(FATAL_ERROR "Auto must leave compiler discovery to CMake")
endif()
generate(imported --import "${TEST_DIRECTORY}/gcc/uvim-config.conf")
file(READ "${TEST_DIRECTORY}/imported/uvim-config.conf" config)
if(NOT config MATCHES "compiler=GCC" OR NOT config MATCHES "cxx_compiler=/toolchain/g[+][+]")
    message(FATAL_ERROR "Compiler selection did not survive import")
endif()
file(WRITE "${TEST_DIRECTORY}/clang/CMakeCache.txt"
    "CMAKE_CXX_COMPILER:FILEPATH=/usr/bin/clang++\n")
execute_process(COMMAND "${UVIM_CONFIG}" --preset embedded --compiler MSVC
    --build-dir "${TEST_DIRECTORY}/clang" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "fresh.*build directory")
    message(FATAL_ERROR "Changing compilers must require a fresh build directory")
endif()
