mod std::thread;
mod std::time;
use std::thread::*;
use std::time::sleep_ms;
__ATTACH_DECLARATION__

struct Point { var x: i32; var y: i32; };
struct Task { var name: str8; var position: Point; var active: bool; };

fn checkpoint(worker_id: i32, round: i32) -> i32 {
    let count: i32 = 40 + round % 1000;
    let enabled: bool = true;
    let ratio: f64 = 1.5;
    let message: str8 = "uvim MLang debugger fixture";
    let point: Point = Point { x: worker_id, y: count };
    let task: Task = Task { name: message, position: point, active: enabled };
    let values: array<i32, 3> = {worker_id, count, 7};
    let result: i32 = task.position.x + values[1];
    if enabled && ratio > 1.0 {
        return result; // DEBUG_BREAKPOINT: inspect locals here
    }
    return 0;
}

fn worker(worker_id: i32) -> i32 {
    var round: i32 = 0;
    while __ITERATIONS__ == 0 || round < __ITERATIONS__ {
        let result: i32 = checkpoint(worker_id, round);
        sleep_ms(__INTERVAL_MS__);
        round = round + 1;
    }
    return 0;
}

fn main() -> i32 {
__ATTACH_SETUP__
__SPAWN_THREADS__
    var round: i32 = 0;
    while __ITERATIONS__ == 0 || round < __ITERATIONS__ {
        let result: i32 = checkpoint(0, round);
        println!("MLang main: round={} result={} workers=__THREADS__", round, result);
        sleep_ms(__INTERVAL_MS__);
        round = round + 1;
    }
__JOIN_THREADS__
    return 0;
}
